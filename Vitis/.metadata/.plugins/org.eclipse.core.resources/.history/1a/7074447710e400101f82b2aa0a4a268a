#include "xil_io.h"
#include "xil_cache.h"
#include "xparameters.h"

#define SCREEN_WIDTH 1920
#define SCREEN_HEIGHT 1080

#define FRAME_BUFFER_1 0x10000000
#define FRAME_BUFFER_2 0x118C0000
#define FRAME_BUFFER_3 0x13180000

void vdma_init(void)
{
    xil_printf("Initializing VDMA...\r\n");

    /* Reset VDMA */
    Xil_Out32(XPAR_AXI_VDMA_0_BASEADDR + 0x00, 0x00000004);
    usleep(10);

    /* Frame buffer address */
    Xil_Out32(XPAR_AXI_VDMA_0_BASEADDR + 0x5C, FRAME_BUFFER_1);

    /* Stride */
    Xil_Out32(XPAR_AXI_VDMA_0_BASEADDR + 0x58, SCREEN_WIDTH * 3);
    Xil_Out32(XPAR_AXI_VDMA_0_BASEADDR + 0x54, SCREEN_WIDTH * 3);

    /* Horizontal size (bytes per line) */
    Xil_Out32(XPAR_AXI_VDMA_0_BASEADDR + 0x48, SCREEN_WIDTH * 3);

    /* Vertical size (lines) — STARTS THE DMA */
    Xil_Out32(XPAR_AXI_VDMA_0_BASEADDR + 0x50, SCREEN_HEIGHT);

    /* Start MM2S */
    Xil_Out32(XPAR_AXI_VDMA_0_BASEADDR + 0x00, 0x00000001);

    xil_printf("VDMA started\r\n");
}


void framebuffer_init(void)
{
    xil_printf("Clearing framebuffer...\r\n");

    Xil_DCacheDisable();

    uint8_t *fb = (uint8_t *)FRAME_BUFFER_1;
    memset(fb, 0x00, SCREEN_WIDTH * SCREEN_HEIGHT * 3);

    Xil_DCacheEnable();
}
